<?php
error_reporting(E_ALL);
ini_set('display_errors', 1);

$dbhost = 'localhost';
$dbuser = 'aarch64linux';
$dbpass = 'aarch64linux';
$dbname = 'aarch64linux';

$conn = new mysqli($dbhost, $dbuser, $dbpass, $dbname);
if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

$counts = [];

// 1. Package Name Mismatches
$result = $conn->query('
    SELECT COUNT(DISTINCT a.name) as count FROM (
        SELECT DISTINCT name FROM packages WHERE system_arch = "aarch64" AND (base IS NOT NULL AND base != "" AND name != base)
    ) a
    INNER JOIN (SELECT DISTINCT name FROM packages WHERE system_arch = "x86_64") x ON a.name = x.name
');
$counts['mismatches'] = $result->fetch_assoc()['count'] ?? 0;

// 2. Outdated "any" packages
$result = $conn->query('
    SELECT COUNT(*) as count FROM (
        SELECT a.name, a.version as aarch64_ver, x.version as x86_64_ver
        FROM (SELECT p.name, p.version FROM packages p JOIN architectures arch ON p.arch_id = arch.id WHERE p.system_arch = "aarch64" AND arch.name = "any" GROUP BY p.name) a
        INNER JOIN (SELECT p.name, p.version FROM packages p JOIN architectures arch ON p.arch_id = arch.id WHERE p.system_arch = "x86_64" AND arch.name = "any" GROUP BY p.name) x ON a.name = x.name
        WHERE a.version < x.version
    ) t
');
$counts['outdated_any'] = $result->fetch_assoc()['count'] ?? 0;

// 3. Missing "any" packages
$result = $conn->query('
    SELECT COUNT(*) as count FROM (
        SELECT x.name FROM (SELECT DISTINCT p.name FROM packages p JOIN architectures arch ON p.arch_id = arch.id WHERE p.system_arch = "x86_64" AND arch.name = "any") x
        LEFT JOIN (SELECT DISTINCT p.name FROM packages p JOIN architectures arch ON p.arch_id = arch.id WHERE p.system_arch = "aarch64" AND arch.name = "any") a ON x.name = a.name
        WHERE a.name IS NULL
    ) t
');
$counts['missing_any'] = $result->fetch_assoc()['count'] ?? 0;

// 4. aarch64-only packages
$result = $conn->query('
    SELECT COUNT(DISTINCT name) as count FROM packages WHERE system_arch = "aarch64"
    AND name NOT IN (SELECT DISTINCT name FROM packages WHERE system_arch = "x86_64")
');
$counts['aarch64_only'] = $result->fetch_assoc()['count'] ?? 0;

// 5. x86_64-only packages
$result = $conn->query('
    SELECT COUNT(DISTINCT name) as count FROM packages WHERE system_arch = "x86_64"
    AND name NOT IN (SELECT DISTINCT name FROM packages WHERE system_arch = "aarch64")
');
$counts['x86_64_only'] = $result->fetch_assoc()['count'] ?? 0;

// 6. aarch64 newer versions
$result = $conn->query('
    SELECT COUNT(*) as count FROM (
        SELECT a.name FROM (SELECT p.name, p.version FROM packages p WHERE p.system_arch = "aarch64" GROUP BY p.name) a
        INNER JOIN (SELECT p.name, p.version FROM packages p WHERE p.system_arch = "x86_64" GROUP BY p.name) x ON a.name = x.name
        WHERE a.version > x.version
    ) t
');
$counts['aarch64_newer'] = $result->fetch_assoc()['count'] ?? 0;

// 7. x86_64 newer versions
$result = $conn->query('
    SELECT COUNT(*) as count FROM (
        SELECT x.name FROM (SELECT p.name, p.version FROM packages p WHERE p.system_arch = "x86_64" GROUP BY p.name) x
        INNER JOIN (SELECT p.name, p.version FROM packages p WHERE p.system_arch = "aarch64" GROUP BY p.name) a ON x.name = a.name
        WHERE x.version > a.version
    ) t
');
$counts['x86_64_newer'] = $result->fetch_assoc()['count'] ?? 0;

// 8. aarch64 older versions
$result = $conn->query('
    SELECT COUNT(*) as count FROM (
        SELECT a.name FROM (SELECT p.name, p.version FROM packages p WHERE p.system_arch = "aarch64" GROUP BY p.name) a
        INNER JOIN (SELECT p.name, p.version FROM packages p WHERE p.system_arch = "x86_64" GROUP BY p.name) x ON a.name = x.name
        WHERE a.version < x.version
    ) t
');
$counts['aarch64_older'] = $result->fetch_assoc()['count'] ?? 0;

// 9. Repository differences
$result = $conn->query('
    SELECT COUNT(*) as count FROM (
        SELECT a.name FROM (SELECT DISTINCT p.name, r.name as repo FROM packages p JOIN repositories r ON p.repo_id = r.id WHERE p.system_arch = "aarch64") a
        INNER JOIN (SELECT DISTINCT p.name, r.name as repo FROM packages p JOIN repositories r ON p.repo_id = r.id WHERE p.system_arch = "x86_64") x ON a.name = x.name
        WHERE a.repo != x.repo
    ) t
');
$counts['repo_diffs'] = $result->fetch_assoc()['count'] ?? 0;

// 10. Orphaned split packages
$result = $conn->query('
    SELECT COUNT(*) as count FROM packages p
    WHERE p.system_arch = "aarch64"
    AND p.base IS NOT NULL AND p.base != ""
    AND p.name != p.base
    AND p.base NOT IN (SELECT DISTINCT name FROM packages WHERE system_arch = "aarch64" AND name = p.base)
    AND p.base IN (SELECT DISTINCT name FROM packages WHERE system_arch = "x86_64" AND name = p.base)
');
$counts['orphaned'] = $result->fetch_assoc()['count'] ?? 0;

$conn->close();

function baseUrl() {
    return 'https://antarctica.no/~solskogen/reporting/';
}
?>
